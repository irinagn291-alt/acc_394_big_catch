    "Reel to raise tension. Ease to lower it. Keep tension between 22% and 82%.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reel to raise tension. Ease to lower it. Keep tension between 22% and 82%."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hole ein, um die Spannung zu erhöhen. Lass locker, um sie zu senken. Halte die Spannung zwischen 22 % und 82 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moulinez pour tendre la ligne. Relâchez pour la détendre. Gardez la tension entre 22 % et 82 %."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recolha para aumentar a tensão. Solte para diminuir. Mantenha a tensão entre 22% e 82%."
          }
        }
      }
    },
