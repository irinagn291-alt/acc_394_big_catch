    "Choose daily bite-window reminders and a monthly season note. Notifications are optional and stay on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle tägliche Beißzeiten und eine monatliche Saisonnotiz. Mitteilungen sind freiwillig und bleiben auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose daily bite-window reminders and a monthly season note. Notifications are optional and stay on this device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez des rappels quotidiens et une note de saison mensuelle. Ils sont facultatifs et restent sur cet appareil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha lembretes diários e um aviso mensal da temporada. São opcionais e ficam neste aparelho."
