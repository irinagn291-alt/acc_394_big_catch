    "Cast into the lake, then watch for a bite. Every fish returns to the water." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirf aus und warte auf einen Biss. Jeder Fisch kommt zurück ins Wasser."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cast into the lake, then watch for a bite. Every fish returns to the water."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez votre ligne, puis guettez une touche. Chaque poisson retourne à l’eau."
