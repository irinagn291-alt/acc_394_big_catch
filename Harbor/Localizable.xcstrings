    "Add Big Catch widgets from your Home Screen or Lock Screen. They show local bite hours, lake progress and your collection without a connection." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Big Catch-Widgets zum Home- oder Sperrbildschirm hinzu. Sie zeigen lokale Beißzeiten, Seenfortschritt und deine Sammlung ohne Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Big Catch widgets from your Home Screen or Lock Screen. They show local bite hours, lake progress and your collection without a connection."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les widgets Big Catch à l’écran d’accueil ou verrouillé. Ils affichent les heures de pêche, la progression et la collection hors ligne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione widgets do Big Catch na tela de início ou bloqueada. Eles mostram horários, progresso e coleção offline."
          }
        }
      }
    },
